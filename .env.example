# Variables de entorno — cópialas a Netlify (Site settings > Environment variables)
# o a un archivo .env para desarrollo local con `netlify dev`.

# --- Transbank / Webpay Plus ---
# En SANDBOX usa estos valores de integración:
TBK_COMMERCE_CODE=597055555532
TBK_API_KEY=579B532A7440BB0C9079DED94D31EA1615BACEB56610332264630D42D0A36B1C
# Cambia a "production" (y actualiza los códigos) cuando estés en producción:
TBK_ENV=integration

# --- Mercado Pago ---
# En SANDBOX usa un access token de prueba (TEST-...). Déjalo vacío para desactivarlo.
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
MP_ENV=sandbox

# --- URL pública del sitio (para las URLs de retorno de las pasarelas) ---
# Netlify la rellena automáticamente; en local usa la de Netlify Dev (normalmente http://localhost:8888)
PUBLIC_SITE_URL=http://localhost:8888